{
  "name": "studybuddy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup:backend": "python -m venv venv && (venv\\Scripts\\pip install -r api/requirements.txt || venv/bin/pip install -r api/requirements.txt)",
    "setup:frontend": "npm install",
    "setup": "npm run setup:frontend && npm run setup:backend",
    "dev:frontend": "vite",
    "dev:backend": "venv\\Scripts\\python -m uvicorn api.main:app --reload --port 8000 || venv/bin/python -m uvicorn api.main:app --reload --port 8000",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\""
  },
